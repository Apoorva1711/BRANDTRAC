# BRANDTRACE Environment Configuration Template

# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/brandtrace
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/brandtrace?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/brandtrace

# JWT Secret for Session Authentication
JWT_SECRET=change-this-to-a-very-secure-random-32-char-string-in-production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Python FastAPI Detection Microservice URL
DETECTION_SERVICE_URL=http://127.0.0.1:8001

# Allowed Frontend Client Origin
CLIENT_ORIGIN=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# Optional External API Keys (Leave blank to use deterministic DEMO DATA fallback)
# TWITTER_BEARER_TOKEN=
# GOOGLE_PLAY_API_KEY=
